# کپی به deploy/instances/YOUR_DOMAIN/.env و مقادیر را پر کنید

COMPOSE_PROJECT_NAME=vpnmarket_example
APP_IMAGE=vpnmarket/app:latest

APP_NAME="ربات نمونه"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://example.com

APP_DOMAIN=example.com
TRAEFIK_ROUTER_NAME=vpnmarket_example
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vpnmarket_example
DB_USERNAME=vpnmarket
DB_PASSWORD=change_me_strong
MYSQL_ROOT_PASSWORD=change_me_root_strong

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=300

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

LOG_CHANNEL=stack
LOG_LEVEL=info

# توکن ربات در پنل ادمین (settings) ذخیره می‌شود؛ در .env اختیاری است
