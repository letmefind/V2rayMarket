# کپی به deploy/instances/YOUR_DOMAIN/.env و مقادیر را پر کنید

COMPOSE_PROJECT_NAME=vpnmarket_example
APP_IMAGE=vpnmarket-local:latest

# شناسه یکتا برای جداسازی داده در دیتابیس مشترک (هر ربات مقدار جدا)
APP_INSTANCE_ID=vpnmarket_example

APP_NAME="ربات نمونه"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://example.com
ASSET_URL=https://example.com

APP_DOMAIN=example.com
TRAEFIK_ROUTER_NAME=vpnmarket_example
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# دیتابیس مشترک بین همهٔ ربات‌ها (نام DB یکی؛ داده با APP_INSTANCE_ID جدا می‌شود)
DB_DATABASE=vpnmarket_shared
DB_USERNAME=vpnmarket
DB_PASSWORD=change_me_strong
MYSQL_ROOT_PASSWORD=change_me_root_strong
SHARED_DATA_NETWORK=vpnmarket_shared_data

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=300

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database

LOG_CHANNEL=stack
LOG_LEVEL=info

# توکن ربات در پنل ادمین (settings) ذخیره می‌شود؛ در .env اختیاری است
