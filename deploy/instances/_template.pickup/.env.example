# وب مشترک کد ۵ رقمی — مثلاً bale.cyou (یک‌بار روی سرور)

COMPOSE_PROJECT_NAME=vpnmarket_pickup
APP_IMAGE=vpnmarket-local:latest

APP_NAME="دریافت اشتراک"
APP_ENV=production
APP_KEY=base64:SAME_OR_NEW_KEY_FOR_PICKUP_ONLY_APP
APP_DEBUG=false
APP_URL=https://bale.cyou

APP_SHARE_PICKUP_ONLY=true
APP_INSTANCE_ID=pickup

APP_DOMAIN=bale.cyou
TRAEFIK_ROUTER_NAME=vpnmarket_pickup
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

# همان دیتابیس مشترک (فقط خواندن/نوشتن service_shares؛ بدون Filament)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vpnmarket_shared
DB_USERNAME=vpnmarket
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

REDIS_HOST=redis
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

RUN_MIGRATIONS=false
WAIT_FOR_DB=true
